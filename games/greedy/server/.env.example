# ===== Greedy game server settings =====
PORT=8080
# Where the SQLite database file is stored
DB_FILE=./data/greedy.db

# ---- Timing (seconds) ----
BETTING_SECONDS=30
SPIN_SECONDS=6
RESULT_SECONDS=5

# ---- Limits ----
CHIPS=10,100,1000,5000,10000
MAX_BET_PER_ROUND=1000000
MIN_BET=10

# ---- Auth ----
# Your app backend signs a JWT (HS256) with this secret: { uid, name, avatar, exp }
GAME_JWT_SECRET=change-me-to-a-long-random-string
# 1 = allow guests without token (ONLY for testing / preview)
DEMO_AUTH=0

# ---- Wallet ----
# local = coins kept inside this server's DB (testing)
# http  = coins kept in YOUR app; this server calls your wallet API
WALLET_MODE=http
WALLET_URL=https://api.your-app.com/greedy-wallet
WALLET_SECRET=change-me-shared-hmac-secret
WALLET_TIMEOUT_MS=5000
# Starting coins for new users in local mode
LOCAL_START_BALANCE=50000

# ---- Admin ----
ADMIN_KEY=change-me-admin-key

# Folder with the game client (index.html). Leave empty to not serve it.
CLIENT_DIR=../client

# ---- Chances (relative weights; defaults total 1006) ----
# W_SHRIMP=96.94
# W_FISH=63.96
# W_CHICKEN=37.58
# W_STEAK=19.99
# W_CABBAGE=193.88
# W_CARROT=193.88
# W_CORN=193.88
# W_TOMATO=193.88
# Salad = all 4 veg win, Pizza = all 4 meat win. Salad+Pizza above ~0.96% = house loses money.
# W_SALAD=4
# W_PIZZA=2
